{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*":              ["./src/*"],
      "@app/*":          ["./src/app/*"],
      "@core/*":         ["./src/core/*"],
      "@shared/*":       ["./src/shared/*"],
      "@features/*":     ["./src/features/*"],
      "@domain/*":       ["./src/domain/*"],
      "@infrastructure/*": ["./src/infrastructure/*"]
    }
  },
  "include": ["src"]
}
